	column 'Source Group' = SWITCH(retention_base[registered_via], 3, "Source 3", 4, "Source 4", 7, "Source 7", 9, "Source 9", "Other")
		dataType: string
		lineageTag: 40315486-12d7-4c69-90d5-2db8aa6df05c
		summarizeBy: none
		sortByColumn: 'Source Group Sort'

	column 'Source Group Sort' = SWITCH(retention_base[registered_via], 3, 1, 4, 2, 7, 3, 9, 4, 5)
		dataType: int64
		formatString: 0
		lineageTag: 0e4784d6-ae76-436d-8549-d9a51071ca4b
		summarizeBy: none

	column 'Analysis Period' = SWITCH(TRUE(), retention_base[registration_date] >= DATE(2015, 7, 1) && retention_base[registration_date] <= DATE(2015, 9, 30), "Baseline", retention_base[registration_date] >= DATE(2015, 10, 1) && retention_base[registration_date] <= DATE(2015, 10, 6), "Oct 1-6", retention_base[registration_date] >= DATE(2015, 10, 7) && retention_base[registration_date] <= DATE(2015, 10, 31), "Oct 7-31", BLANK())
		dataType: string
		lineageTag: e233bd29-2254-4fdc-8a53-9ce4b2c715f8
		summarizeBy: none
		sortByColumn: 'Analysis Period Sort'

	column 'Analysis Period Sort' = SWITCH(TRUE(), retention_base[registration_date] >= DATE(2015, 7, 1) && retention_base[registration_date] <= DATE(2015, 9, 30), 1, retention_base[registration_date] >= DATE(2015, 10, 1) && retention_base[registration_date] <= DATE(2015, 10, 6), 2, retention_base[registration_date] >= DATE(2015, 10, 7) && retention_base[registration_date] <= DATE(2015, 10, 31), 3, 99)
		dataType: int64
		formatString: 0
		lineageTag: 0e7fc164-1445-402e-b35a-c85b61a82afb
		summarizeBy: none

	column 'Analysis Period CN' = SWITCH(TRUE(), retention_base[registration_date] >= DATE(2015, 7, 1) && retention_base[registration_date] <= DATE(2015, 9, 30), "7月至9月基准期", retention_base[registration_date] >= DATE(2015, 10, 1) && retention_base[registration_date] <= DATE(2015, 10, 6), "10月1日至6日", retention_base[registration_date] >= DATE(2015, 10, 7) && retention_base[registration_date] <= DATE(2015, 10, 31), "10月7日至31日", BLANK())
		dataType: string
		lineageTag: a13bbf85-7766-4cb8-a1a8-e585cf33a4af
		summarizeBy: none
		sortByColumn: 'Analysis Period Sort'

	column 'Source Group CN' = SWITCH(retention_base[registered_via], 3, "来源3", 4, "来源4", 7, "来源7", 9, "来源9", "其他")
		dataType: string
		lineageTag: 5a95fdbd-c53b-48a8-b772-1f87e934771e
		summarizeBy: none
		sortByColumn: 'Source Group Sort'

