table retention_base
	lineageTag: 7fc32fea-b098-441b-8fbd-c1dadf14bd4c

	measure 'New Users' = DISTINCTCOUNT(retention_base[msno])
		formatString: #,0
		lineageTag: 8bd1ad32-280a-44ef-9919-9cdb4ae9b854

	measure 'D7 Retention' = AVERAGE(retention_base[d7_retained])
		formatString: 0.00%
		lineageTag: 2269167b-8649-45e2-9fab-b109bdcc9e69

	measure 'D30 Retention' = AVERAGE(retention_base[d30_retained])
		formatString: 0.00%
		lineageTag: 542bbb53-a231-44b2-8a75-bccce7d93511

	measure 'Avg First 7D Active Days' = AVERAGE(retention_base[first_7d_active_days])
		formatString: 0.00
		lineageTag: 8a7fd945-d5b7-40e3-bfb2-9ed02c5a230e

	measure 'D30 Oct 1-6' = CALCULATE([D30 Retention], retention_base[Analysis Period] = "Oct 1-6")
		formatString: 0.00%
		lineageTag: 98ec3314-1a5a-49b1-a45e-c1c6fe068ace

	measure 'D30 Oct 7-31' = CALCULATE([D30 Retention], retention_base[Analysis Period] = "Oct 7-31")
		formatString: 0.00%
		lineageTag: a45722af-6bbb-4bbe-a30a-284b2a13b26a

	measure 'D30 Change pp' = ([D30 Oct 7-31] - [D30 Oct 1-6]) * 100
		formatString: 0.00
		lineageTag: fc6425b7-0d24-42f8-9522-b8532ef3fcc4

	measure 'New Users Oct 7-31' = CALCULATE([New Users], retention_base[Analysis Period] = "Oct 7-31")
		formatString: #,0
		lineageTag: 5ec8401c-6755-425e-b215-fae683427df3

	measure 'Source 4 Users Oct 7-31' = CALCULATE([New Users], retention_base[Analysis Period] = "Oct 7-31", retention_base[registered_via] = 4)
		formatString: #,0
		lineageTag: 5dcbb63c-4db5-45f5-9d24-a296f88f2bbc

	measure 'Source 4 Share Oct 7-31' = DIVIDE([Source 4 Users Oct 7-31], [New Users Oct 7-31])
		formatString: 0.00%
		lineageTag: f649e345-ed08-4860-8433-df50b3b8cd1e

	measure 'Source 4 D7 Oct 7-31' = CALCULATE([D7 Retention], retention_base[Analysis Period] = "Oct 7-31", retention_base[registered_via] = 4)
		formatString: 0.00%
		lineageTag: 09ec8610-f6a0-45b7-8a13-4ec18540f06b

	measure 'Source 4 D30 Oct 7-31' = CALCULATE([D30 Retention], retention_base[Analysis Period] = "Oct 7-31", retention_base[registered_via] = 4)
		formatString: 0.00%
		lineageTag: 06125e21-3130-44fa-8eac-7477404f2ca3

	measure 'Activated User Rate' = AVERAGEX(retention_base, IF(NOT ISBLANK(retention_base[first_active_date]), 1.0, 0.0))
		formatString: 0.00%
		lineageTag: 9fcde50c-b475-438e-812a-d104cc9dc2fe

	measure 'Avg First 7D Total Secs' = AVERAGE(retention_base[first_7d_total_secs])
		formatString: #,0.00
		lineageTag: 427f7626-9468-451a-990e-fc82702b95ea

	measure 'Avg First 7D Complete Plays' = AVERAGE(retention_base[first_7d_num_100])
		formatString: 0.00
		lineageTag: 6dd9e204-e365-4a2a-94db-0caf340ffb3f

	measure 'D7 Retention Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([D7 Retention], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: 0.00%
		lineageTag: 60ec496a-c3be-4641-b49c-4fdaf7e0617f

	measure 'D30 Retention Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([D30 Retention], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: 0.00%
		lineageTag: 20437303-aeea-426a-a02a-51ca4c06d112

	measure 'Activated User Rate Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([Activated User Rate], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: 0.00%
		lineageTag: 12f85be8-7265-4a72-af5b-75b9cd330faf

	measure 'Avg First 7D Active Days Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([Avg First 7D Active Days], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: 0.00
		lineageTag: 5364928e-a14d-4078-aeb9-37651b8b9de6

	measure 'Avg First 7D Total Secs Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([Avg First 7D Total Secs], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: #,0.00
		lineageTag: 83effd76-b9bb-403e-afcf-4292f2dd77e5

	measure 'Avg First 7D Complete Plays Oct 7-31 Major Source' = VAR CurrentSource = SELECTEDVALUE(retention_base[Source Group]) RETURN IF(CurrentSource = "Other", BLANK(), CALCULATE([Avg First 7D Complete Plays], retention_base[Analysis Period] = "Oct 7-31"))
		formatString: 0.00
		lineageTag: 53794443-a776-4abc-8cb8-9c0e87733067

