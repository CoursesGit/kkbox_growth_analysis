                      "fontFamily": "Microsoft YaHei UI",
                      "fontSize": "10pt",
                      "color": "#17324d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "结构分解：7月至9月基准期D30为10.02%，10月全月D30为7.15%；来源结构变化贡献-5.13个百分点，来源内部表现改善+2.26个百分点，最终净变化为-2.87个百分点。",
                    "textStyle": {
                      "fontFamily": "Microsoft YaHei UI",
                      "fontSize": "10pt",
                      "color": "#4b6478"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "核心解读：整体留存下降主要来自新用户来源结构变化，而不是原有主要来源的留存普遍恶化。",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Microsoft YaHei UI",
                      "fontSize": "10pt",
                      "color": "#17324d"
                    }
                  }
                ]
              },
